# Math Live — environment variables
# Copy to `.env` and fill in. Everything here is OPTIONAL: with no env at all
# the app runs in no-login, file-persistence mode. See DEPLOY.md and SUPABASE.md.

# ─── Server ───────────────────────────────────────────────────────────────
# Port the Node server listens on (Express + Socket.IO + Vite). Default 3000.
PORT=3000

# Lock socket CORS to your real domain(s) in production (comma-separated
# exact origins). Unset = open ('*'), fine for local/dev.
# ALLOWED_ORIGINS=https://math-live-colab.onrender.com
ALLOWED_ORIGINS=

# ─── Teacher accounts (login + dashboard) — optional ──────────────────────
# Public Supabase keys, inlined into the CLIENT bundle at BUILD time, so they
# must be set BEFORE `npm run build` (changing them later needs a rebuild).
# Without them the app runs in no-login mode. See SUPABASE.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Server-side teacher-ownership enforcement — optional ─────────────────
# When all three are set, a registered class can only be DRIVEN by its owning
# signed-in teacher. Absent → no enforcement (legacy name-based behaviour).
# SUPABASE_URL / SUPABASE_ANON_KEY usually match the VITE_ values above.
# The SERVICE_ROLE key is secret — server-only, never exposed to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Durable rooms across restarts — optional ─────────────────────────────
# Upstash Redis REST credentials. Without them rooms persist to .rooms/ only
# (wiped on a free-tier restart). See DEPLOY.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── AI Lesson generation ("✨ AI Lesson") — optional ─────────────────────
# Server-side ONLY — the key never reaches the browser. Without it the AI
# button reports "not configured". Get a key at aistudio.google.com.
GEMINI_API_KEY=
