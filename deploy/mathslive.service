[Unit]
Description=MathsLive
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
# These two belong to [Unit], NOT [Service]. systemd ignores them in the wrong
# section with only a log line, which is how the restart cap survived a review:
# the unit looked right and behaved as though the setting was never written.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=mathslive
WorkingDirectory=/opt/mathslive
EnvironmentFile=/opt/mathslive/deploy/mathslive.env
ExecStart=/usr/bin/npm start

# Restart forever, not five times.
#
# On 24 Aug the app ran out of memory and the host's restart policy gave up
# after five attempts, so a crash that a restart fixes cost eight hours of
# downtime. A tutoring platform should come back on its own at 2am; StartLimit
# is disabled deliberately so nothing can decide to stop trying.
Restart=always
RestartSec=3

# Journald keeps the output; the app logs plainly to stdout.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mathslive

# Modest hardening. The app writes only inside its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
