# Copy to deploy/mathslive.env on the server, fill in, then:
#   chown mathslive:mathslive deploy/mathslive.env && chmod 600 deploy/mathslive.env
#
# This file holds secrets. It is gitignored and must never be committed.

NODE_ENV=production
PORT=4000

# ── Database ───────────────────────────────────────────────────────────────
# Postgres runs on this same box. The password was generated by bootstrap.sh
# and written to /root/.mathslive-db-pass.
DATABASE_URL=postgresql://mathslive:PASSWORD_FROM_ROOT_FILE@127.0.0.1:5432/mathslive

# ── Memory ─────────────────────────────────────────────────────────────────
# Sized for the 1 GB Lightsail tier, which also runs Postgres and the OS.
# The heap is the ceiling; the budget is where idle rooms start being shed,
# deliberately lower so eviction happens BEFORE the ceiling rather than after —
# the 24 Aug crash was the heap hitting its limit with nothing left to shed.
#
# On a 2 GB box (after an AWS limit increase, or anywhere else) raise these to
# 768 / 512 and drop MAX_FILES_PER_ROOM back to its default.
NODE_HEAP_MB=384
MEMORY_BUDGET_MB=256
SWEEP_INTERVAL_MS=60000
# A room may hold 12 files x 2MB by default. On 1 GB that single room can
# outweigh everything else on the machine, so the ceiling comes down with it.
MAX_FILES_PER_ROOM=6

# ── Access ─────────────────────────────────────────────────────────────────
SITE_PASSCODE=
# Comma-separated, exact origins. Include the test name during the trial run
# and the real name at cutover, or the browser will refuse the socket.
ALLOWED_ORIGINS=https://aws.matheinstein.com,https://class.matheinstein.com

# ── Supabase (auth) ────────────────────────────────────────────────────────
# NOTE: the VITE_ pair is read at BUILD time, not run time. If they are missing
# when `npm run build` runs, sign-in silently does nothing in the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── AI lesson generation ───────────────────────────────────────────────────
GEMINI_API_KEY=

# ── TURN (video calls on mobile data / school wifi) ────────────────────────
# From metered.ca — free tier. Without these the call is STUN-only and cannot
# connect on networks with no direct path.
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=

# ── Subscriptions ──────────────────────────────────────────────────────────
# A teacher gets 7 free days from first sign-in, then pays. Nothing here is
# automated: a teacher scans the QR, pays by UPI, types the reference, and an
# admin confirms it on /admin. No gateway account, no card data, no fees.
#
# The QR image itself is a FILE on this box, not in the bundle, so it can be
# replaced without a rebuild. Put the Paytm/UPI QR here:
PAYTM_QR_PATH=/opt/mathslive/deploy/paytm-qr.png
# Shown as a fallback under the QR for anyone who cannot scan it.
PAYTM_UPI_ID=
PAYTM_PAYEE_NAME=MathsLive

# Where "someone says they paid" alerts go. Email is the reliable channel and
# uses RESEND_API_KEY above; set this or payment claims land only in the log.
OWNER_EMAIL=

# WhatsApp alerts (optional, in addition to email). Meta Cloud API.
# NOTE: Meta only allows a free-form message within 24 hours of the recipient
# messaging the business number, so this can go quiet without warning — which
# is exactly why the email is sent too, and never instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
OWNER_WHATSAPP=

# ── Telegram alerts (recommended; free, instant, no 24-hour window) ─────────
# The channel that actually reaches a phone: payment claims from the app, and
# "the site is down" / "memory is high" / "the backup did not run" from the
# watchdog, backup and restore-test scripts. Email still goes as the record.
#
# To set up, once, in about two minutes:
#   1. In Telegram, message @BotFather → /newbot → follow it → copy the token.
#   2. Send your new bot any message (a bot cannot write to you first).
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy the
#      "chat":{"id":...} number.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Off-box backup (do set this) ────────────────────────────────────────────
# The nightly dump lives on the same disk as the database it came from, so it
# does not survive losing the instance. An rclone remote fixes that; Backblaze
# B2's free allowance is far more than this database will need for years.
#   rclone config    (once, as root, on the box) → then e.g. b2:mathslive-backups
BACKUP_REMOTE=

# ── Rate limits (all optional; the defaults are in src/server/rateLimit.ts) ──
# Only set one of these if a real person is being refused — every default is
# far above what a teacher or a class can produce and far below what a script
# does. See PLAN.md task 0.2.
# MAGIC_LINK_PER_EMAIL_PER_HOUR=5
# MAGIC_LINK_PER_IP_PER_HOUR=20
# AUTH_CALLBACK_PER_HOUR=30
# API_WRITES_PER_MIN=60
# SESSION_WRITES_PER_MIN=20
# PUBLISH_PER_HOUR=10
# SOCKET_CONNECT_PER_MIN=300
# SESSION_BODY_LIMIT=8mb
